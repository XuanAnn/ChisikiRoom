{
  "name": "chisikiroom",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "format": "prettier --write \"backend/src/**/*.java\" \"backend/src/**/*.yml\" \"desktop/src/**/*.{ts,tsx,css}\" \"desktop/electron/**/*.{cjs,mjs,mts}\" \"desktop/tests/**/*.cjs\" \"desktop/*.{ts,json,html,yml}\" \"scripts/**/*.cjs\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,json,html,cjs}\" \"frontend/tests/**/*.cjs\" package.json .prettierrc.json compose.yaml",
    "format:check": "prettier --check \"backend/src/**/*.java\" \"backend/src/**/*.yml\" \"desktop/src/**/*.{ts,tsx,css}\" \"desktop/electron/**/*.{cjs,mjs,mts}\" \"desktop/tests/**/*.cjs\" \"desktop/*.{ts,json,html,yml}\" \"scripts/**/*.cjs\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,json,html,cjs}\" \"frontend/tests/**/*.cjs\" package.json .prettierrc.json compose.yaml",
    "postinstall": "npm --prefix desktop install && npm --prefix frontend install",
    "db": "node scripts/run.cjs db",
    "backend": "node scripts/run.cjs backend",
    "build": "npm --prefix desktop run build",
    "desktop": "node scripts/run.cjs desktop",
    "start": "npm run desktop",
    "test:backend": "mvn -f backend/pom.xml test",
    "test:integration": "node scripts/verify-lan.cjs",
    "test:desktop": "npm --prefix desktop run test:e2e",
    "package:win": "npm --prefix desktop run package:win",
    "web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "test:web": "npm --prefix frontend test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0"
  }
}
