# Development proxy target. Only Vite's dev server reads this value.
BACKEND_URL=http://127.0.0.1:8080
# To use the deployed server during local web development:
# BACKEND_URL=https://api.nguyenxuanan.id.vn
# Optional absolute backend origin; cross-origin servers need an explicit CORS/WS policy.
# Prefer leaving this empty and serving /api and /ws on the same origin in production.
VITE_API_URL=
