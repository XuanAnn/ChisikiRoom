{
  "name": "chisikiroom-desktop",
  "version": "0.9.0",
  "description": "ChisikiRoom desktop chat, quizzes and realtime battles",
  "author": "ChisikiRoom",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/*.test.cjs",
    "test:session": "node --test tests/session.test.cjs",
    "package:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "antd": "^5.27.0",
    "@ant-design/icons": "^6.0.0"
  }
}
